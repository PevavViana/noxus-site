# Copie para .env (desenvolvimento local) ou cadastre no painel do Netlify:
# Project configuration > Environment variables
#
# Chave da API do Gemini (https://aistudio.google.com/apikey).
# Opcional: sem ela, o site usa o Netlify AI Gateway automaticamente.
GEMINI_API_KEY=
#
# Modelo opcional (padrão: gemini-3-flash-preview)
GEMINI_MODEL=
